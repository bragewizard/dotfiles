[user]
    email = brage.wis@gmail.com
    name = Brage Wiseth
[init]
    defaultBranch = main
[core]
    editor = helix
    pager = delta
[http]
    postBuffer = 157286400
[pull]
    ff = only
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    # side-by-side = true
[merge]
    conflictStyle = zdiff3
